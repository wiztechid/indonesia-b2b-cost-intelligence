{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDP Service RFQ",
  "type": "object",
  "required": ["serviceType", "organization", "scope", "commercial"],
  "properties": {
    "serviceType": {
      "enum": ["dpo_service", "dpia", "gap_assessment", "privacy_audit"]
    },
    "organization": {
      "type": "object",
      "required": ["entityCount", "industry", "jurisdictions"],
      "properties": {
        "employeeBand": {"type": ["string", "null"]},
        "entityCount": {"type": "integer", "minimum": 1},
        "industry": {"type": "string", "minLength": 1},
        "jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["systems", "processingActivities", "processorsVendors", "dataSubjectBand", "specialData", "onsiteRequired", "deliverables"],
      "properties": {
        "systems": {"type": ["integer", "null"], "minimum": 0},
        "processingActivities": {"type": ["integer", "null"], "minimum": 0},
        "processorsVendors": {"type": ["integer", "null"], "minimum": 0},
        "dataSubjectBand": {"type": ["string", "null"]},
        "specialData": {"type": ["boolean", "null"]},
        "onsiteRequired": {"type": ["boolean", "null"]},
        "deliverables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      },
      "additionalProperties": false
    },
    "commercial": {
      "type": "object",
      "required": ["termMonths", "currency", "taxIncludedRequested", "travelIncludedRequested", "paymentScheduleRequested"],
      "properties": {
        "termMonths": {"type": ["integer", "null"], "minimum": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "default": "IDR"},
        "taxIncludedRequested": {"type": ["boolean", "null"]},
        "travelIncludedRequested": {"type": ["boolean", "null"]},
        "paymentScheduleRequested": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
