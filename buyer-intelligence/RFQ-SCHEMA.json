{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PDP Service RFQ",
  "type":"object",
  "required":["serviceType","organization","scope","commercial"],
  "properties":{
    "serviceType":{"enum":["dpo_service","dpia","gap_assessment","privacy_audit"]},
    "organization":{"type":"object","properties":{
      "employeeBand":{"type":"string"},
      "entityCount":{"type":"integer","minimum":1},
      "industry":{"type":"string"},
      "jurisdictions":{"type":"array","items":{"type":"string"}}
    }},
    "scope":{"type":"object","properties":{
      "systems":{"type":"integer","minimum":0},
      "processingActivities":{"type":"integer","minimum":0},
      "processorsVendors":{"type":"integer","minimum":0},
      "dataSubjectBand":{"type":"string"},
      "specialData":{"type":"boolean"},
      "onsiteRequired":{"type":"boolean"},
      "deliverables":{"type":"array","items":{"type":"string"}}
    }},
    "commercial":{"type":"object","properties":{
      "termMonths":{"type":"integer","minimum":1},
      "currency":{"type":"string","default":"IDR"},
      "taxIncludedRequested":{"type":"boolean"},
      "travelIncludedRequested":{"type":"boolean"},
      "paymentScheduleRequested":{"type":"boolean"}
    }}
  }
}
