{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B2B Cost Intelligence Evidence Record",
  "type": "object",
  "required": ["evidenceId","topic","source","evidenceClass","checkedAt","status"],
  "properties": {
    "evidenceId": {"type":"string"},
    "topic": {"type":"string"},
    "claim": {"type":"string"},
    "source": {
      "type":"object",
      "required":["url","name","authority","ownerKey"],
      "properties":{
        "url":{"type":"string","format":"uri"},
        "name":{"type":"string"},
        "authority":{"enum":["official_instrument","court","regulator","procurement_record","vendor","consultancy","publisher","other"]},
        "ownerKey":{"type":"string"}
      }
    },
    "evidenceClass":{"enum":["law","judicial_decision","official_guidance","advertised_price","vendor_quote","procurement_value","independent_estimate","methodology","market_context"]},
    "value":{"type":["number","null"]},
    "currency":{"type":["string","null"]},
    "unit":{"type":["string","null"]},
    "scope":{"type":["object","null"]},
    "publishedAt":{"type":["string","null"],"format":"date"},
    "issuedAt":{"type":["string","null"],"format":"date"},
    "effectiveAt":{"type":["string","null"],"format":"date"},
    "checkedAt":{"type":"string","format":"date"},
    "status":{"enum":["discovery_only","candidate","verified","superseded","excluded"]},
    "exclusionReason":{"type":["string","null"]},
    "notes":{"type":["string","null"]}
  },
  "additionalProperties": false
}
